                }
              },
              "required": ["label", "category", "url", "listed_in"],
              "additionalProperties": false
            }
          },
          "category_count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Entries the two lists hold."
          },
          "url": {
            "type": "string",
            "description": "The page these categories were read from."
