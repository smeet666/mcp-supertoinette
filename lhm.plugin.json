    {
      "name": "scale_ingredients",
      "title": "Rescale a list of ingredients",
      "description": "Rescale a list of French ingredient lines, offline. Give either 'factor', or 'from_servings' and 'to_servings' together. Each line comes back with what was done to it: 'scaled' when the arithmetic landed exactly, 'rounded' when the value had to move to stay something a kitchen can measure out, and 'unscaled' when the line carries no quantity at all. Nothing is converted between unit systems, and an approximate measure such as a pincée keeps its own size.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ingredients": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "description": "The lines to rescale, as the recipe wrote them."
          },
          "factor": {
            "description": "What to multiply the quantities by. Give this, or the two servings counts.",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "from_servings": {
            "description": "How many the list was written for.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "to_servings": {
            "description": "How many it should serve.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1000
          }
        },
        "required": ["ingredients"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "factor": {
            "type": "number",
            "description": "What the quantities were multiplied by."
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "The line as it now reads."
                },
                "original": {
                  "type": "string",
                  "description": "The line as it was given."
                },
                "scaling": {
                  "type": "string",
                  "enum": ["scaled", "rounded", "unscaled"],
                  "description": "'scaled' when the number is the product itself, 'rounded' when the value moved or a floor was reached, 'unscaled' when the line carries nothing multipliable."
                },
                "amount": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The scaled quantity, read together with 'unit'."
                },
                "amount_max": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Upper bound when the line gives a range."
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The unit 'amount' is in, which may differ from the original."
                },
                "is_heading": {
                  "type": "boolean",
                  "description": "True for a line naming a part of the recipe rather than an ingredient."
                },
                "note": {
                  "description": "Why the line was rounded, clamped or left alone.",
                  "type": "string"
                }
              },
              "required": [
                "text",
                "original",
                "scaling",
                "amount",
                "amount_max",
                "unit",
                "is_heading"
              ],
              "additionalProperties": false
            }
          },
          "scaled_count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Lines whose arithmetic landed exactly."
          },
          "rounded_count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Lines whose value had to move."
          },
          "unscaled_count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Lines carrying no quantity."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "factor",
          "ingredients",
          "scaled_count",
          "rounded_count",
          "unscaled_count",
          "notes"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
