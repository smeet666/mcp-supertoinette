{
  "author": "Damien Bouissou",
  "authorUrl": "https://github.com/smeet666",
  "description": "MCP server for Supertoinette. Read French recipes, rescale them, browse categories, ingredient sheets and wine pairings.",
  "homepage": "https://github.com/smeet666/mcp-supertoinette#readme",
  "identifier": "smeet666-mcp-supertoinette",
  "name": "mcp-supertoinette",
  "prompts": [],
  "resources": [],
  "tags": [
    "mcp",
    "model-context-protocol",
    "supertoinette",
    "recipes",
    "cooking",
    "french-recipes"
  ],
  "tools": [
    {
      "name": "get_recipe",
      "title": "Read one recipe",
      "description": "Read one recipe on Supertoinette by its identifier, which is the number in its address: 4210 in /recette/4210/veloute-de-gaverole.html. Returns the ingredients, the steps, the times, the difficulty and the cost the site publishes. A time the site does not publish comes back as null rather than as zero. Pass 'servings' to rescale the quantities: each line then says whether the arithmetic landed exactly, or had to move to stay an amount a kitchen can measure out.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "description": "The number in the recipe's address, such as '4210'. Search for a dish when you do not have one."
          },
          "servings": {
            "description": "Rescale the quantities to this many. Left out, they come back as the site published them. It is refused when the site's own wording carries no number to scale from.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1000
          }
        },
        "required": ["id"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "The title with the pictogram the site opens it with taken off."
          },
          "title_as_published": {
            "type": "string",
            "description": "The title exactly as the site wrote it."
          },
          "url": {
            "type": "string",
            "description": "The public page. Show this when citing the recipe."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "yield": {
            "type": "object",
            "properties": {
              "original_count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The number the site printed, when its wording carries one."
              },
              "original_text": {
                "type": "string",
                "description": "The site's own wording, which is the claim it made."
              },
              "requested": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "What the caller asked for."
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The site's own word for what it counts."
              },
              "factor": {
                "type": "number",
                "description": "What the quantities were multiplied by."
              }
            },
            "required": ["original_count", "original_text", "requested", "unit", "factor"],
            "additionalProperties": false,
            "description": "How many the recipe was written for, and how many were asked for."
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "The line as it now reads."
                },
                "original": {
                  "type": "string",
                  "description": "The line as it was given."
                },
                "scaling": {
                  "type": "string",
                  "enum": ["scaled", "rounded", "unscaled"],
                  "description": "'scaled' when the number is the product itself, 'rounded' when the value moved or a floor was reached, 'unscaled' when the line carries nothing multipliable."
                },
                "amount": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The scaled quantity, read together with 'unit'."
                },
                "amount_max": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Upper bound when the line gives a range."
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The unit 'amount' is in, which may differ from the original."
                },
                "is_heading": {
                  "type": "boolean",
                  "description": "True for a line naming a part of the recipe rather than an ingredient."
                },
                "note": {
                  "description": "Why the line was rounded, clamped or left alone.",
                  "type": "string"
                }
              },
              "required": [
                "text",
                "original",
                "scaling",
                "amount",
                "amount_max",
                "unit",
                "is_heading"
              ],
              "additionalProperties": false
            }
          },
          "ingredient_count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Lines rendered, headings included."
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "intro": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The prose the page prints above the steps."
          },
          "prep_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when the site publishes no preparation time."
          },
          "cook_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when the site publishes no cooking time."
          },
          "total_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "rest_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Resting time, which the page prints as 'Pause'."
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "rating": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "description": "Reviews counted."
                  },
                  "scale": {
                    "type": "number",
                    "description": "The top of the scale, as published."
                  }
                },
                "required": ["value", "count", "scale"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "nutrition": {
            "type": "null",
            "description": "Supertoinette publishes none."
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  }
                },
                "required": ["label"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "The site's own wording. It publishes no scale for this, so none is stated."
          },
          "cost_level": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "level": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "scale": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["label", "level", "scale"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "The site's own wording, with the scale it draws the symbols on."
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "category": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Pass this back to browse the category. Null when the link opens no listing."
                },
                "url": {
                  "type": "string"
                }
              },
              "required": ["label", "category", "url"],
              "additionalProperties": false
            }
          },
          "ingredient_sheets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "string",
                  "description": "The words the site linked, as published."
                },
                "sheet_id": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": ["line", "sheet_id", "slug", "url"],
              "additionalProperties": false
            }
          },
          "faq": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string"
                },
                "answer": {
                  "type": "string"
                }
              },
              "required": ["question", "answer"],
              "additionalProperties": false
            }
          },
          "source": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
