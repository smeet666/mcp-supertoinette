    {
      "name": "search_recipes",
      "title": "Search the recipes",
      "description": "Search Supertoinette by a dish or an ingredient. Each row carries the identifier to read the recipe with get_recipe. The site publishes no total, so 'total_available' is null and 'last_page' says how far the results run. The categories it counts beside a search are returned as 'facets': pass one back as 'category' to narrow the search, spelled exactly as the site spells it. A category the site does not know is answered like a search that matched nothing, so a filter that finds nothing is dropped and the answer says so.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "A dish or an ingredient to look for, in French."
          },
          "limit": {
            "description": "Rows to render, 20 by default. The site serves at most 39 to a page, and 'rows_published' always states what the page held.",
            "type": "integer",
            "minimum": 1,
            "maximum": 39
          },
          "page": {
            "description": "Which page of results to read, 1 by default. 'last_page' says how far they run.",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "category": {
            "description": "Narrow the search to one category, taken from the 'facets' of a previous answer and spelled exactly as the site spells it. Never build one by hand: the site answers a wording it does not know with a page that reads as an absence.",
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": ["query"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The page these rows were read from."
          },
          "last_page": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The highest page the site links to from this one."
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The category the answer was narrowed to, or null for a search across all of them."
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Pass this to get_recipe."
                },
                "title": {
                  "type": "string",
                  "description": "The title with the pictogram the site opens it with taken off."
                },
                "title_as_published": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "The public page. Show this when citing the recipe."
                },
                "image_url": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The categories the site files the row under."
                }
              },
              "required": [
                "id",
                "title",
                "title_as_published",
                "url",
                "image_url",
                "description",
                "categories"
              ],
              "additionalProperties": false
            }
          },
          "result_count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Rows rendered here."
          },
          "rows_published": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Rows the page held, before any were rendered."
          },
          "total_available": {
            "type": "null",
            "description": "Supertoinette prints no total on a search page, so there is none to report."
          },
          "facets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": ["label", "count"],
              "additionalProperties": false
            },
            "description": "The categories the site counts inside this search. A recipe filed under two is counted by both, so these do not add up to the rows served."
          },
          "url": {
            "type": "string",
            "description": "The page these rows were read from."
          },
          "source": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "query",
          "page",
          "last_page",
          "category",
          "results",
          "result_count",
          "rows_published",
          "total_available",
          "facets",
          "url",
          "source",
          "notes"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_categories",
      "title": "List the categories recipes are browsed by",
      "description": "List the categories Supertoinette browses its recipes by. Each entry carries the token that opens its listing with browse_recipes, and 'listed_in' says where the site printed it: its footer holds the kinds of dish, its menu holds the ways of cooking and the seasons. Never build a token by hand, because the site answers a number paired with the wrong name with a page it does not hold. These two lists are not every category the site files recipes under: a recipe's own tags open onto hundreds more that neither list publishes.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
